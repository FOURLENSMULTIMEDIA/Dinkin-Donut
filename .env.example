# Host console password. Set the real one in Vercel → Settings → Environment Variables.
# For local testing, create .env.local (never committed) or run: HOST_PIN=yourpin npm run dev
HOST_PIN=
# Second sign-in step (6 digits)
HOST_PIN_2=
# Added automatically when you connect Upstash Redis in Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Shared with the Google Form sync script (google-form/GlazeCardSync.gs)
MEMBERS_SECRET=
# WhatsApp Business Cloud API (see whatsapp/SETUP.md)
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=glaze_pass
WA_LANG=en
WA_VERIFY_TOKEN=
